# Auth (required)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Must match the URL users open in the browser (no trailing slash)
# Local:  http://localhost:3000
# Vercel: https://sorappscrm.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Optional comma-separated extra origins (custom domains, preview aliases)
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com,https://preview.example.com

# Optional extra Android TWA signing certs (comma-separated SHA-256 fingerprints).
# The internal sideload keystore fingerprint is always included.
# TWA_SHA256_FINGERPRINTS=AA:BB:...

# Neon / Postgres (required)
# Prefer the pooled connection string for Vercel/serverless
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# BulkSMS Nigeria (activation + PAYGO reminder SMS)
# Get token from https://www.bulksmsnigeria.com
BULK_SMS_TOKEN=
# Sender ID max 11 chars (must be approved on BulkSMS Nigeria)
BULK_SMS_SENDER=Sorapps
# live | sandbox
BULK_SMS_MODE=live

# PAYGO amount → validity (default unlock period for stipulated installment)
PAYGO_BASE_VALIDITY_DAYS=30
# SMS reminder days before installment due / PAYGO expiry
PAYGO_REMINDER_DAYS_BEFORE=7
# Overdue SMS (true/false) and re-send interval in days
PAYGO_OVERDUE_SMS_ENABLED=true
PAYGO_OVERDUE_SMS_INTERVAL_DAYS=3
# Protects /api/cron/paygo-reminders (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=

# Cloudflare R2 (site photos on New Sale)
# Create an R2 bucket + API token with Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sorapps
# Public base URL (custom domain or r2.dev public bucket URL), no trailing slash
R2_PUBLIC_URL=

# Optional — only for local seeding (pnpm db:seed). Not needed on Vercel.
# SEED_ADMIN_EMAIL=admin@sorapps.local
# SEED_ADMIN_PASSWORD=SorappsAdmin123!
# SEED_ADMIN_NAME=Sorapps Admin
